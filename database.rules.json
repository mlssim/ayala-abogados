{
  "rules": {
    ".read": false,
    ".write": false,

    "usuarios": {
      ".read": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administradores').child(auth.uid).child('activo').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('administradores').child(auth.uid).child('activo').val() === true)",
        ".validate": "newData.hasChildren(['uid', 'nombre', 'apellidos', 'email', 'role', 'active'])",
        "role": {
          ".validate": "root.child('administradores').child(auth.uid).child('activo').val() === true || (!data.exists() && newData.val() === 'usuario')"
        },
        "active": {
          ".validate": "root.child('administradores').child(auth.uid).child('activo').val() === true || (!data.exists() && newData.val() === true)"
        }
      }
    },

    "administradores": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administradores').child(auth.uid).child('activo').val() === true)",
        ".write": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true"
      }
    },

    "citas": {
      ".read": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true",
      ".write": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true",
      "$citaId": {
        ".write": "!data.exists() || (auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true)",
        ".validate": "newData.hasChildren(['nombre', 'telefono', 'email', 'tipo_consulta'])"
      }
    },

    "notificaciones": {
      ".read": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true",
      ".write": "auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true",
      "$notifId": {
        ".write": "!data.exists() || (auth != null && root.child('administradores').child(auth.uid).child('activo').val() === true)"
      }
    }
  }
}
